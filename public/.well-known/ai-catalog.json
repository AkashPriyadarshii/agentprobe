{
  "name": "agentprobe",
  "version": "0.0.2",
  "description": "The open-source Lighthouse for AI Agents",
  "homepage": "https://agentprobe-self.vercel.app",
  "repository": "https://github.com/AkashPriyadarshii/agentprobe",
  "capabilities": ["web-audit", "llms-txt-check", "robots-txt-check", "json-ld-check", "ci-gate"],
  "resources": [
    {
      "name": "Documentation",
      "type": "docs",
      "url": "https://agentprobe-self.vercel.app/docs"
    },
    {
      "name": "llms.txt",
      "type": "llms-txt",
      "url": "https://agentprobe-self.vercel.app/llms.txt"
    }
  ],
  "endpoints": {
    "audit": "/api/audit?url={url}",
    "docs": "/docs"
  }
}
